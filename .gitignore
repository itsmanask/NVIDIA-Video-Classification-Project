*.bak

# ================================
# Data folders (raw/processed, Dataset)
# ================================

# Raw data (ignore everything but .gitkeep in subfolders)
video_classification_project/data/raw/train/*
!video_classification_project/data/raw/train/.gitkeep

video_classification_project/data/raw/test/*
!video_classification_project/data/raw/test/.gitkeep

video_classification_project/data/raw/val/*
!video_classification_project/data/raw/val/.gitkeep

# Processed data (ignore everything but .gitkeep in subfolders)
video_classification_project/data/processed/train/*
!video_classification_project/data/processed/train/.gitkeep

video_classification_project/data/processed/test/*
!video_classification_project/data/processed/test/.gitkeep

video_classification_project/data/processed/val/*
!video_classification_project/data/processed/val/.gitkeep

# Old processed files (ignore completely)
Processed Files Old/
models old/

# Dataset folder
Dataset/

